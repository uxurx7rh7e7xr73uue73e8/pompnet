# Copy these values into Railway Variables. Never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-during-initial-setup
# Prefer a generated long random value in production.
SECRET_KEY=replace-with-a-long-random-secret
# Set COOKIE_SECURE=false only for local HTTP development.
COOKIE_SECURE=true
AGENT_URL=
AGENT_TOKEN=
AGENT_TIMEOUT=8
